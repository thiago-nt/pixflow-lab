{
  "uid": "pixflow-infra", "title": "PixFlow Lab - Saude da infraestrutura", "tags": ["pixflow", "gate07"], "timezone": "browser", "schemaVersion": 41, "version": 1, "refresh": "5s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Scrape targets", "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (job) (up)", "legendFormat": "{{job}}"}]},
    {"id": 2, "type": "timeseries", "title": "CPU dos processos Java", "gridPos": {"h": 8, "w": 9, "x": 6, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "process_cpu_usage{job=~\"payment-api|outbox-relay|payment-worker|psp-simulator|reconciliation-worker\"}", "legendFormat": "{{job}}"}]},
    {"id": 3, "type": "timeseries", "title": "Heap por servico", "gridPos": {"h": 8, "w": 9, "x": 15, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (job) (jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "{{job}}"}]},
    {"id": 4, "type": "timeseries", "title": "Threads vivas", "gridPos": {"h": 9, "w": 8, "x": 0, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (job) (jvm_threads_live_threads)", "legendFormat": "{{job}}"}]},
    {"id": 5, "type": "timeseries", "title": "Conexoes Hikari ativas", "gridPos": {"h": 9, "w": 8, "x": 8, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (job) (hikaricp_connections_active)", "legendFormat": "{{job}}"}]},
    {"id": 6, "type": "timeseries", "title": "Pausas GC", "gridPos": {"h": 9, "w": 8, "x": 16, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (job) (rate(jvm_gc_pause_seconds_sum[5m]))", "legendFormat": "{{job}}"}]}
  ]
}
