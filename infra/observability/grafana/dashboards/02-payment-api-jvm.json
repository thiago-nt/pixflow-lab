{
  "uid": "pixflow-payment-api", "title": "PixFlow Lab - Payment API e JVM", "tags": ["pixflow", "gate07"], "timezone": "browser", "schemaVersion": 41, "version": 1, "refresh": "5s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Requisicoes por resultado", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (outcome) (rate(pixflow_payment_requests_total[5m]))", "legendFormat": "{{outcome}}"}]},
    {"id": 2, "type": "timeseries", "title": "Latencia HTTP P50/P95/P99", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"payment-api\"}[5m])))", "legendFormat": "P50"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"payment-api\"}[5m])))", "legendFormat": "P95"}, {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"payment-api\"}[5m])))", "legendFormat": "P99"}]},
    {"id": 3, "type": "timeseries", "title": "Taxa de erros HTTP", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_count{job=\"payment-api\",status=~\"4..|5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"payment-api\"}[5m])), 0.001)", "legendFormat": "erro"}]},
    {"id": 4, "type": "timeseries", "title": "Heap JVM", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(jvm_memory_used_bytes{job=\"payment-api\",area=\"heap\"})", "legendFormat": "usado"}, {"refId": "B", "expr": "sum(jvm_memory_max_bytes{job=\"payment-api\",area=\"heap\"})", "legendFormat": "maximo"}]},
    {"id": 5, "type": "timeseries", "title": "GC e threads", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(rate(jvm_gc_pause_seconds_sum{job=\"payment-api\"}[5m]))", "legendFormat": "GC s/s"}, {"refId": "B", "expr": "sum(jvm_threads_live_threads{job=\"payment-api\"})", "legendFormat": "threads"}]},
    {"id": 6, "type": "timeseries", "title": "HikariCP", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(hikaricp_connections_active{job=\"payment-api\"})", "legendFormat": "ativas"}, {"refId": "B", "expr": "sum(hikaricp_connections_max{job=\"payment-api\"})", "legendFormat": "maximo"}]}
  ]
}

