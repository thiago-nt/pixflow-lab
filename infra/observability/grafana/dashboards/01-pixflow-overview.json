{
  "uid": "pixflow-overview", "title": "PixFlow Lab - Visao geral", "tags": ["pixflow", "gate07"], "timezone": "browser", "schemaVersion": 41, "version": 1, "refresh": "5s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Servicos monitorados ativos", "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum(up{job=~\"payment-api|outbox-relay|payment-worker|psp-simulator|reconciliation-worker\"})", "legendFormat": "ativos"}]},
    {"id": 2, "type": "stat", "title": "Pagamentos UNKNOWN", "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "max(pixflow_payments_unknown)", "legendFormat": "unknown"}]},
    {"id": 3, "type": "timeseries", "title": "Throughput HTTP por servico", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (job) (rate(http_server_requests_seconds_count[5m]))", "legendFormat": "{{job}}"}]},
    {"id": 4, "type": "timeseries", "title": "Resultados financeiros confirmados", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (outcome) (rate(pixflow_payment_results_total[5m]))", "legendFormat": "{{outcome}}"}]},
    {"id": 5, "type": "timeseries", "title": "Erros HTTP 5xx", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (job) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))", "legendFormat": "{{job}}"}]}
  ]
}

