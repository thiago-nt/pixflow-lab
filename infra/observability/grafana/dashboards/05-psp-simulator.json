{
  "uid": "pixflow-psp", "title": "PixFlow Lab - PSP Simulator", "tags": ["pixflow", "gate07"], "timezone": "browser", "schemaVersion": 41, "version": 1, "refresh": "5s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Operacoes PSP por resultado", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (operation, outcome) (rate(pixflow_psp_operations_total[5m]))", "legendFormat": "{{operation}} {{outcome}}"}]},
    {"id": 2, "type": "timeseries", "title": "Efeito financeiro novo ou replay", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (effect) (rate(pixflow_psp_operations_total{operation=\"charge\"}[5m]))", "legendFormat": "{{effect}}"}]},
    {"id": 3, "type": "timeseries", "title": "Latencia HTTP P50/P95/P99", "gridPos": {"h": 9, "w": 12, "x": 0, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"psp-simulator\"}[5m])))", "legendFormat": "P50"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"psp-simulator\"}[5m])))", "legendFormat": "P95"}, {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"psp-simulator\"}[5m])))", "legendFormat": "P99"}]},
    {"id": 4, "type": "timeseries", "title": "Erros HTTP PSP", "gridPos": {"h": 9, "w": 12, "x": 12, "y": 8}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"psp-simulator\",status=~\"4..|5..\"}[5m]))", "legendFormat": "HTTP {{status}}"}]}
  ]
}

